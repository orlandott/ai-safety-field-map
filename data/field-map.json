{
  "meta": {
    "title": "The AI Safety field, by the numbers",
    "updated": "2025",
    "defaultMetric": "people",
    "metrics": {
      "people": {
        "label": "People (FTEs)",
        "unit": "FTEs",
        "note": "Full-time-equivalent researchers, 2017–2025. The 2025 technical figures are taken directly from McAleese's org-by-org dataset (629 FTEs across 69 orgs, aggregated by category: misc technical ~200, interpretability 122, evals 100 — AISI ~50, METR ~31, Apollo ~19 — LLM safety 87, …). Non-technical 2025 is ~500: governance ~250, non-technical research ~120, advocacy/field-building ~60, ethics/other ~50. 2025 technical points are anchored to that dataset; every earlier year is modeled — technical history is reconstructed from each org's founding year and normalised to McAleese's published technical totals (≈30 in 2017, ≈50 in 2020, ≈300 in 2022), and the non-technical splits are modeled from his category totals (we don't yet have the org-level non-technical sheet). Every point carries its own source (see the per-year sourcing table below): 'anchor' = straight from the dataset, 'modeled' = our reconstruction. Per-bucket splits are approximate, so totals don't sum exactly.",
        "auto": false
      },
      "papers": {
        "label": "Papers / year",
        "unit": "papers",
        "note": "A research-VOLUME proxy: arXiv papers per year matching each branch's search terms. Auto-refreshed monthly by scripts/fetch-field-map.mjs. Noisy and over-counts where terms are broad — read it as relative effort, not a headcount.",
        "auto": true
      }
    },
