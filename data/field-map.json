{
  "meta": {
    "title": "The AI Safety field, by the numbers",
    "updated": "2025",
    "defaultMetric": "people",
    "metrics": {
      "people": {
        "label": "People (FTEs)",
        "unit": "FTEs",
        "note": "Full-time-equivalent researchers, 2017–2025. The 2025 column is taken directly from McAleese's org-by-org dataset — 118 organisations totalling ~1,130 FTEs: ~624 technical (misc technical 200, interpretability 122, evals 100 [AISI 50, METR 31, Apollo 19], LLM safety 87, …) and ~505 non-technical (governance 249, non-technical research 146, advocacy 79, forecasting 25, watchdog/whistleblower 6). Every 2025 point is anchored to that dataset; earlier years are modeled — each category's history is reconstructed from its organisations' founding years and normalised to McAleese's published totals (≈30 technical in 2017, ≈50 in 2020, ≈300 technical + ≈100 non-technical in 2022). Every point carries its own source (see the per-year sourcing table below): 'anchor' = straight from the dataset, 'modeled' = our founding-year reconstruction. Per-bucket splits are approximate, so totals don't sum exactly.",
        "auto": false
      },
      "papers": {
        "label": "Papers / year",
        "unit": "papers",
        "note": "A research-VOLUME proxy: arXiv papers per year matching each branch's search terms. Auto-refreshed monthly by scripts/fetch-field-map.mjs. Noisy and over-counts where terms are broad — read it as relative effort, not a headcount.",
        "auto": true
      }
    },
